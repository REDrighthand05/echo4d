<?xml version="1.0" encoding="utf-8"?>
<!-- Record screen. EchoScene desktop frontend, minimal: a dark sheet, the
     blue graffiti behind one frosted-glass panel, floating borderless
     components on the glass. One screen, one job. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Blue graffiti behind the glass. Kept quiet (low alpha, short)
             so it reads as a backdrop, not a loud scribble. -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:alpha="0.30"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/bg_graffiti" />

        <!-- The single frosted-glass sheet. -->
        <LinearLayout
            style="@style/GlassPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/EchoTitle" />

            <TextView
                android:id="@+id/probeStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/EchoBody" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/status_idle"
                android:textAppearance="@style/EchoStatus" />

            <TextView
                android:id="@+id/lastResultText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/EchoBody" />

            <!-- Live camera preview while recording. A rounded viewfinder
                 with a faint border, so it reads as a camera — not a black
                 hole with text in it. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FF141A26"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_border"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/previewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/previewHintText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/preview_hint"
                        android:textAppearance="@style/EchoBody" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Record / stop. A calm rectangular button, not a giant
                 screaming pill — the 72dp full-width pill is what made the
                 screen look like a scam ad. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/recordButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="@string/record"
                android:textSize="17sp"
                app:backgroundTint="@color/accent_blue"
                app:cornerRadius="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lensMainButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/lens_main"
                    app:backgroundTint="@color/glass_fill"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/glass_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lensUltrawideButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/lens_ultrawide"
                    app:backgroundTint="@color/glass_fill"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/glass_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/lensNoteText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/EchoBody" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/sensors_title"
                android:textAppearance="@style/EchoStatus"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/sensorChecklistText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/EchoBody" />
        </LinearLayout>

        <!-- Watchdog warning. Hidden unless a stream stalls. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/warningCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#33FFC107"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/warning_amber"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/warningText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearWarningButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/dismiss"
                    android:textColor="@color/warning_amber" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Navigation: the only other two screens. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/capturesButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/title_captures"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/glass_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/diagnosticsButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/title_diagnostics"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/glass_border" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
