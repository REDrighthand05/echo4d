<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera: the only capture permission. No audio is recorded. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Foreground service + wake lock: keep recording alive with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Notification permission (Android 13+) for the foreground notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera is required; ARCore is required (motion tracking is the core). -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="true" />
    <!-- Sensors are probed at runtime; none is a hard install requirement. -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.light" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EchoCollector">

        <!-- ARCore: required. The app refuses to record poses without it, but
             still records video + sensors. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="required" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CapturesActivity"
            android:exported="false"
            android:label="@string/title_captures"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/title_diagnostics"
            android:screenOrientation="portrait" />

        <!-- Foreground service holding the whole recording session. Type
             "camera" so Android 14 lets it use the camera while backgrounded. -->
        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="camera" />
    </application>

</manifest>
